# ~/.config/shared_shell/settings - shared settings for Bash and Zsh

if [ -n "${ZSH_VERSION}" ]; then
	# Emacs mode (e.g. ctrl+a to start of line, ctrl+e to end of line)
	# Has to be set before the forward/backward-word lines
	bindkey -e
	bindkey "\e[1;5C" forward-word # Find key sequences by entering read and replacing ^[ with \e
	bindkey "\e[1;5D" backward-word

elif [ -n "${BASH_VERSION}" ]; then
	# Copies Zsh behaviour of completing commands with up and down arrows
	# E.g. entering cd and pressing the arrows shows your last commands beginning with cd
	bind '"\e[A": history-search-backward'
	bind '"\e[B": history-search-forward'
fi
