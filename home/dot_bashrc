# ~/.bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then . /etc/bashrc; fi

# Source bash completion
if [ -f /etc/bash_completion ]; then
	. /etc/bash_completion
elif [ -f /usr/share/bash-completion/bash_completion ]; then
	. /usr/share/bash-completion/bash_completion
fi

# Source shared shell configuration
for file in "${HOME}"/.shared_shell/*; do
	[ -r "$file" ] && [ -f "$file" ] && source "$file"
done

# Source Bash-specific configuration
for file in "${HOME}"/.bash/*; do
	[ -r "$file" ] && [ -f "$file" ] && source "$file"
done

unset file

if [ -f "${HOME}/.gitstatus/gitstatus.prompt.sh" ]; then
	source "${HOME}/.gitstatus/gitstatus.prompt.sh"
	PROMPT_COMMAND='PROMPT_EXIT_CODE=$?; history -a; history -n; my_prompt $PROMPT_EXIT_CODE'
else
	PROMPT_COMMAND='history -a; history -n;'
fi

if command -v fzf >/dev/null 2>&1; then
	eval "$(fzf --bash)"
fi
